{
  "properties": {
    "activities": [
      {
        "name": "Exceute ADF Pipeline",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "method": "POST",
          "headers": {},
          "relativeUrl": {
            "value": "subscriptions/@{pipeline().parameters.SubscriptionId}/resourceGroups/@{pipeline().parameters.ResourceGroupName}/providers/Microsoft.DataFactory/factories/@{pipeline().parameters.DataFactoryName}/pipelines/@{pipeline().parameters.PipelineName}/createRun?api-version=2018-06-01",
            "type": "Expression"
          },
          "body": {
            "value": "@pipeline().parameters.Body",
            "type": "Expression"
          }
        },
        "externalReferences": {
          "connection": "41de3500-22e1-4b46-92f3-b1a80a6a0c08"
        }
      },
      {
        "name": "Until ADF Pipeline Run is Finished",
        "type": "Until",
        "dependsOn": [
          {
            "activity": "Exceute ADF Pipeline",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@or(\n    equals(activity('Get ADF Pipeline Status').output.status, 'Failed'),\n    equals(activity('Get ADF Pipeline Status').output.status, 'Succeeded')\n)",
            "type": "Expression"
          },
          "activities": [
            {
              "name": "Get ADF Pipeline Status",
              "type": "WebActivity",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "method": "GET",
                "headers": {},
                "relativeUrl": {
                  "value": "subscriptions/@{pipeline().parameters.SubscriptionId}/resourceGroups/@{pipeline().parameters.ResourceGroupName}/providers/Microsoft.DataFactory/factories/@{pipeline().parameters.DataFactoryName}/pipelineruns/@{activity('Exceute ADF Pipeline').output.runId}?api-version=2018-06-01",
                  "type": "Expression"
                }
              },
              "externalReferences": {
                "connection": "41de3500-22e1-4b46-92f3-b1a80a6a0c08"
              }
            },
            {
              "name": "Wait 20 Seconds",
              "type": "Wait",
              "dependsOn": [
                {
                  "activity": "Get ADF Pipeline Status",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "waitTimeInSeconds": 20
              }
            }
          ],
          "timeout": "0.12:00:00"
        }
      },
      {
        "name": "If ADF Pipeline Run Succeeded",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "Until ADF Pipeline Run is Finished",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@equals(activity('Get ADF Pipeline Status').output.status, 'Succeeded')",
            "type": "Expression"
          },
          "ifFalseActivities": [
            {
              "name": "ADF Pipeline Run Failed",
              "type": "Fail",
              "dependsOn": [],
              "typeProperties": {
                "message": {
                  "value": "@activity('Get ADF Pipeline Status').output.message",
                  "type": "Expression"
                },
                "errorCode": "1"
              }
            }
          ],
          "ifTrueActivities": [
            {
              "name": "Return Status",
              "type": "SetVariable",
              "dependsOn": [],
              "policy": {
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "variableName": "pipelineReturnValue",
                "value": [
                  {
                    "key": "Status",
                    "value": {
                      "type": "Expression",
                      "content": "@activity('Get ADF Pipeline Status').output"
                    }
                  }
                ],
                "setSystemVariable": true
              }
            }
          ]
        }
      }
    ],
    "parameters": {
      "SubscriptionId": {
        "type": "string"
      },
      "ResourceGroupName": {
        "type": "string"
      },
      "DataFactoryName": {
        "type": "string"
      },
      "PipelineName": {
        "type": "string"
      },
      "Body": {
        "type": "string"
      }
    }
  }
}