{
  "properties": {
    "activities": [
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@pipeline().parameters.IsLineageSetupActive",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "ae39be8e-10cd-ad33-408d-f6d899dc16c1",
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "parameters": {
                  "governance_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Governance_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "data_workspace_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_DataWorkspaceID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "attach_environment_to_notebooks": {
                    "value": {
                      "value": "@pipeline().parameters.AttachEnvironmentToNotebooks",
                      "type": "Expression"
                    },
                    "type": "bool"
                  }
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Invoke NB_LineageSetup",
              "description": "Ensures the OpenLineage Environment, uploads the transport JAR, points its spark.openlineage.* properties at the governance lakehouse and publishes. Attaching the Environment to the ETL notebooks costs about a minute each, so AttachEnvironmentToNotebooks is off by default. Turn both switches on for a deployment bootstrap, then sync the workspace back to git.",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "If LineageSetup is activated",
        "dependsOn": []
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@pipeline().parameters.IsLineageSemanticModelsActive",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "05c9af90-f40b-896b-4792-f3caeeafe7a1",
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "parameters": {
                  "governance_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Governance_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "data_workspace_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_DataWorkspaceID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "platin_workspaces": {
                    "value": {
                      "value": "@pipeline().parameters.PlatinWorkspaces",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "_inlineInstallationEnabled": {
                    "value": true,
                    "type": "bool"
                  }
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Invoke NB_LineageSemanticModels",
              "description": "Collects Power BI semantic models into semantic_models.platin_* in the governance lakehouse. Runs before the snapshot, which folds those tables in as layer = platin. PlatinWorkspaces takes one workspace GUID or several separated by commas.",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "If LineageSemanticModels is activated",
        "dependsOn": [
          {
            "activity": "If LineageSetup is activated",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      },
      {
        "type": "IfCondition",
        "typeProperties": {
          "expression": {
            "value": "@pipeline().parameters.IsLineageSnapshotActive",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "type": "TridentNotebook",
              "typeProperties": {
                "notebookId": "5c8d8ec7-a4c8-94ca-4acb-26a292d2b3a9",
                "workspaceId": "00000000-0000-0000-0000-000000000000",
                "parameters": {
                  "governance_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Governance_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "data_workspace_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_DataWorkspaceID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "bronze_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Bronze_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "silver_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Silver_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  },
                  "gold_lakehouse_id": {
                    "value": {
                      "value": "@pipeline().libraryVariables.VL_LH_Gold_ID",
                      "type": "Expression"
                    },
                    "type": "string"
                  }
                }
              },
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureInput": false,
                "secureOutput": false
              },
              "name": "Invoke NB_LineageSnapshot",
              "description": "Parses the OpenLineage events the ETL emits into lineage.events, lineage.snapshot, lineage.edges and lineage.dataset_schema. The lakehouse GUIDs say which medallion layer each dataset path belongs to.",
              "dependsOn": []
            }
          ],
          "ifFalseActivities": []
        },
        "name": "If LineageSnapshot is activated",
        "dependsOn": [
          {
            "activity": "If LineageSemanticModels is activated",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ]
      }
    ],
    "parameters": {
      "IsLineageSetupActive": {
        "type": "bool",
        "defaultValue": false
      },
      "AttachEnvironmentToNotebooks": {
        "type": "bool",
        "defaultValue": false
      },
      "IsLineageSemanticModelsActive": {
        "type": "bool",
        "defaultValue": true
      },
      "IsLineageSnapshotActive": {
        "type": "bool",
        "defaultValue": true
      },
      "PlatinWorkspaces": {
        "type": "string",
        "defaultValue": "<serve-workspace-guid>,<another-serve-workspace-guid>"
      }
    },
    "libraryVariables": {
      "VL_DataWorkspaceID": {
        "type": "String",
        "variableName": "DataWorkspaceID",
        "libraryName": "Variables_Environment_Config"
      },
      "VL_LH_Governance_ID": {
        "type": "String",
        "variableName": "LH_Governance_ID",
        "libraryName": "Variables_Environment_Config"
      },
      "VL_LH_Bronze_ID": {
        "type": "String",
        "variableName": "LH_Bronze_ID",
        "libraryName": "Variables_Environment_Config"
      },
      "VL_LH_Silver_ID": {
        "type": "String",
        "variableName": "LH_Silver_ID",
        "libraryName": "Variables_Environment_Config"
      },
      "VL_LH_Gold_ID": {
        "type": "String",
        "variableName": "LH_Gold_ID",
        "libraryName": "Variables_Environment_Config"
      }
    }
  }
}